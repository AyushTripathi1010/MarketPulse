# ============================================================================
# MarketPulse — example environment file
#
# COPY THIS to .env and fill in real values. The real .env is GITIGNORED.
# Never commit secrets to git. If you ever do, ROTATE the key — don't just
# git-rm it (history keeps it forever).
# ============================================================================

# --- Market data ------------------------------------------------------------
# yFinance needs no key (it's unofficial), but Alpaca does.
# Get free keys at: https://alpaca.markets/  → paper trading account
ALPACA_API_KEY=PK_YOUR_KEY_HERE
ALPACA_API_SECRET=YOUR_SECRET_HERE
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# --- LLM providers ----------------------------------------------------------
# Groq for the Critic agent + Report generation. Free tier: 30 RPM, 14.4K req/day.
# Get a key at: https://console.groq.com
GROQ_API_KEY=gsk_YOUR_KEY_HERE

# Hugging Face for the Phi-3 fine-tune (download + push). Free.
# Create a token at: https://huggingface.co/settings/tokens (read+write scope)
HF_TOKEN=hf_YOUR_TOKEN_HERE

# --- Observability ----------------------------------------------------------
# Langfuse (self-hosted on your AWS EC2). Public + secret keys come from
# the Langfuse UI under Settings → API Keys.
LANGFUSE_HOST=http://localhost:3000           # local dev; replace with EC2 URL in prod
LANGFUSE_PUBLIC_KEY=pk-lf-YOUR_KEY_HERE
LANGFUSE_SECRET_KEY=sk-lf-YOUR_KEY_HERE

# --- Storage ----------------------------------------------------------------
# AWS — your personal account.
AWS_ACCESS_KEY_ID=YOUR_AWS_KEY
AWS_SECRET_ACCESS_KEY=YOUR_AWS_SECRET
AWS_DEFAULT_REGION=us-east-1
S3_BUCKET=marketplus-yourname            # bucket you create in S3

# --- ML tracking ------------------------------------------------------------
# DagsHub MLflow — free 10GB. Sign up at https://dagshub.com
DAGSHUB_TOKEN=your_dagshub_token_here
MLFLOW_TRACKING_URI=https://dagshub.com/<your-username>/marketplus.mlflow
MLFLOW_TRACKING_USERNAME=<your-username>
MLFLOW_TRACKING_PASSWORD=$DAGSHUB_TOKEN

# --- Service URLs (used by orchestrator to call other services) -------------
# In docker-compose these resolve to container names. In Lambda, point them
# to API Gateway URLs or directly invoke the corresponding Lambda.
DATA_INGEST_URL=http://data_ingest:8000
FORECAST_URL=http://forecast:8000
CRITIC_URL=http://critic:8000
REPORT_URL=http://report:8000
BACKTEST_URL=http://backtest:8000

# --- Local infra (only used in docker-compose) ------------------------------
QDRANT_URL=http://qdrant:6333
REDIS_URL=redis://redis:6379

# --- Environment label ------------------------------------------------------
# Used to tag MLflow runs and Langfuse traces.
ENVIRONMENT=local
